```{r}
#3.1
library(dplyr)
library(ggplot2)
library(gridExtra)

datos_problema_3 <- datos_importantes %>% 
  mutate(acciones_padre_niño = case_when(
    str_detect(acciones_padre_niño, "B") ~ "Reprimenda Verbal",
    str_detect(acciones_padre_niño, "K") ~ "Diálogo",
    str_detect(acciones_padre_niño, "E") ~ "Golpe"))

conteo_acciones <- datos_problema_3 %>%
  filter(!is.na(acciones_padre_niño)) %>% 
  count(acciones_padre_niño)

ggplot(conteo_acciones, aes(x = acciones_padre_niño, y = n)) +
  geom_bar(stat = "identity", fill = "BLUE") +
  labs(title = "Entre lo verbal y los golpes o castigos físicos, ¿qué eligen más los padres?",
       x = "Acción",
       y = "Cantidad") +
  theme_minimal()

```

