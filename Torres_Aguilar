```{r}
# Parte 2.3

datos_acp <- datos_importantes %>% 
  mutate(persona_corrige_niño = case_when(
    str_detect(persona_corrige_niño, "A") ~ "MADRE",
    str_detect(persona_corrige_niño, "B") ~ "PADRE",
    str_detect(persona_corrige_niño, "C") ~ "ABUELOS",
    str_detect(persona_corrige_niño, "D") ~ "HERMANOS",
    str_detect(persona_corrige_niño, "Y") ~ "NADIE LO CORRIGE"))

brando <- datos_acp %>%
  filter(!is.na(persona_corrige_niño)) %>% 
  count(persona_corrige_niño)

ggplot(brando, aes(x = persona_corrige_niño, y = n)) +
  geom_histogram(stat = "identity", fill = "PURPLE") +
  labs(title = "Quienes corrigen al niño(a) cuando se porta mal",
       x = "Persona encargada",
       y = "Frecuencia") +
  theme_bw()

# Se observa que la madre es la que en la gran mayoría de casos corrige a los niños cuando se portan mal. Además, el segundo caso más común es que al niño no se le corrija.

```

